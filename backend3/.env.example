# Backend Configuration Example
# Скопируйте этот файл в .env и настройте под свои нужды

# JWT Settings
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15   # Время жизни access токена в минутах
JWT_REFRESH_EXPIRATION=7   # Время жизни refresh токена в днях

# Database Configuration (SQLite)
DB_PATH=./data.db          # Путь к файлу базы данных SQLite

# Server Configuration
PORT=:8000

# Примечания:
# - JWT_SECRET должен быть длинным и случайным в продакшене
# - Используйте длинный JWT_SECRET (минимум 32 символа)
# - JWT_ACCESS_EXPIRATION: рекомендуется 15-30 минут
# - JWT_REFRESH_EXPIRATION: рекомендуется 7-30 дней
# - DB_PATH: путь к SQLite файлу (будет создан автоматически при первом запуске)
